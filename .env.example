# llm-manager token file (gitignored, NOT committed — see .env.example).
# Copy to token.env and set your secret, then reload the API:
#   cp .env.example token.env && vim token.env
#
# Plain KEY=VALUE lines; '#' comments and blank lines are ignored.
# Values already set in the real environment ALWAYS win over this file.

LLM_API_TOKEN=replace-with-a-long-random-secret
